@model myproject.Models.Student

@{
    ViewData["Title"] = "Create Student";
}

<h1>Create Student</h1>

<form asp-action="Create" method="post" id="studentForm">
    <!-- The Form Tag Helper normally generates an anti-forgery token for this POST form. -->

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" required />
        <span asp-validation-for="Name" class="text-danger"></span>
        <!-- This extra span displays our custom JavaScript business-rule message. -->
        <span id="nameError" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Program" class="form-label"></label>
        <input asp-for="Program" class="form-control" />
        <span asp-validation-for="Program" class="text-danger"></span>
        <span id="programError" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Student</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <!-- Enables ASP.NET Core's unobtrusive client-side validation for Data Annotations. -->
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("studentForm");

            form.addEventListener("submit", function (event) {
                const name = document.getElementById("Name").value.trim();
                const program = document.getElementById("Program").value.trim();

                const nameError = document.getElementById("nameError");
                const programError = document.getElementById("programError");

                // Clear messages from a previous submission attempt.
                nameError.textContent = "";
                programError.textContent = "";

                let isValid = true;

                // Name permits letters, spaces, hyphens, and apostrophes only.
                const namePattern = /^[a-zA-Z\s'-]+$/;

                if (name === "") {
                    nameError.textContent = "Please enter the student's name.";
                    isValid = false;
                } else if (!namePattern.test(name)) {
                    nameError.textContent =
                        "Name must contain only letters, spaces, hyphens, or apostrophes.";
                    isValid = false;
                }

                // Program permits selected characters and must contain at least one letter.
                const programPattern = /^[a-zA-Z0-9\s&()'-]+$/;

                if (program === "") {
                    programError.textContent = "Please enter the student's program.";
                    isValid = false;
                } else if (!programPattern.test(program)) {
                    programError.textContent = "Program contains invalid characters.";
                    isValid = false;
                } else if (!/[a-zA-Z]/.test(program)) {
                    programError.textContent = "Program must contain at least one letter.";
                    isValid = false;
                }

                // Stop the POST request if either field fails custom validation.
                if (!isValid) {
                    event.preventDefault();
                }
            });
        });
    </script>
}