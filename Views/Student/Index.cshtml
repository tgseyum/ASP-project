@model List<myproject.Models.Student>

<h1>Students</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Program</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Program</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-primary">
                        Edit
                    </a>

                    <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    var demoUser = Context.Session.GetString("DemoUser");
}

@if (!string.IsNullOrEmpty(demoUser))
{
    <div class="alert alert-success">
        Hello, @demoUser. The demo session value is present.
    </div>
}
else
{
    <div class="alert alert-info">
        You are not signed in to the classroom demo.
        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary btn-sm">
            Login
        </a>
    </div>
}