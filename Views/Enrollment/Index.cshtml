@model IEnumerable<myproject.Models.Enrollment>

<h2>Enrollment Records</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Enroll Student</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Enrollment ID</th>
            <th>Student</th>
            <th>Course</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var enrollment in Model)
        {
            <tr>
                <td>@enrollment.Id</td>
                <td>@enrollment.Student?.Name</td>
                <td>@enrollment.Course?.CourseName</td>
            </tr>
        }
    </tbody>
</table>